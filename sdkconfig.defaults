# Espressif IoT Development Framework (ESP-IDF) project minimal configuration for the
# Waveshare ESP32-S3-Touch-LCD-2.8C (ESP32-S3R8, 8 MB octal PSRAM, 16 MB flash).
#
CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash. QIO at 80 MHz is what the module is specified for.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# 8 MB octal PSRAM. The radar keeps two full-size canvases (RGB565 + ARGB8888), the LVGL draw
# buffers, and HTTP response buffers here, so PSRAM is the binding resource on this board rather
# than internal RAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Allocations at or below this size are forced into internal RAM. The ESP32-P4 build used 1024,
# which it could afford; here it starves the chip. The radar UI builds hundreds of LVGL objects
# of roughly 300 bytes each -- aircraft markers, airport labels, menu rows -- and at 1024 every
# one of them lands internal, leaving about 15 KB free with PSRAM 85% empty and no room for the
# TLS handshake. At 128 those objects go to PSRAM, where they are only ever touched by the CPU.
# Anything that genuinely needs internal or DMA-capable memory asks for it by capability and is
# unaffected.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=128
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
# Run code and read-only data from PSRAM. Required by the RGB panel, not a performance choice.
# The panel has no memory of its own, so the LCD peripheral reads the frame out of PSRAM without
# pause. Normally every flash write -- each NVS save counts -- disables the cache that PSRAM is
# reached through, and the scanout's bounce-buffer refill then faults:
#   "Cache disabled but cached memory region accessed"
# With both of these on, IDF keeps the cache enabled across flash operations instead
# (SPI_FLASH_CACHE_NO_DISABLE in spi_flash_os_func_app.c). The cost is PSRAM: .text and .rodata
# are copied into it at boot, about 2.7 MB of the 8 MB. Waveshare's own demos for this board
# enable the same pair.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# RGB scanout robustness, as in the vendor demo and the capsule-radar port.
# Deliberately NOT setting LCD_RGB_ISR_IRAM_SAFE, although the vendor demo does. The driver's
# bounce-buffer fill and ISR are IRAM_ATTR regardless; the option only adds a guarantee that
# they keep running while the cache is disabled, and XIP above means it never is. It also makes
# esp_lcd_rgb_panel_register_event_callbacks() demand an internal-RAM user context, which the
# LVGL adapter's (calloc'd, so in PSRAM under SPIRAM_MALLOC_ALWAYSINTERNAL=128) is not:
#   lcd_panel.rgb: user context not in internal RAM
# LVGL then never hears that a flush finished and the display hangs after its first frame.
# CONFIG_LCD_RGB_ISR_IRAM_SAFE is not set
# After an underrun the DMA restarts at the next VSYNC. Without this a single starved bounce
# buffer leaves the picture permanently shifted until reboot; with it, one frame glitches.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
# 64-byte data cache lines, from Waveshare's sdkconfig.defaults for this board. Doubles the burst
# size of every PSRAM fill, which is what the bounce-buffer copy lives on.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# The S3 renders LVGL entirely in software, so the CPU clock is on the critical path for the
# sweep redraw in a way it was not on the P4.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Native WiFi. The ESP32-P4 build reached WiFi through esp_wifi_remote/esp_hosted and a C6
# co-processor; the S3 has its own radio, so those components are gone entirely.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# WiFi has to be trimmed to share internal RAM with the LVGL draw buffers. At stock settings
# esp_wifi_init() fails with ESP_ERR_NO_MEM and ESP_ERROR_CHECK panics the board into a boot
# loop, with the heap reporting plenty free but no block large enough.
#
# The IRAM options are the big win: they place WiFi's hot paths in IRAM, which on this chip
# comes out of the same DIRAM the draw buffers need. Running that code from the flash cache
# costs WiFi throughput, which this firmware does not need -- it makes one ADS-B fetch every
# few seconds, not a sustained stream.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# Static RX buffers are DMA-capable and therefore always internal. Dynamic ones can live in
# PSRAM, so shift the balance towards those.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=8

# TLS against the ADS-B feeds is the largest single RAM consumer after the canvases. The S3 has
# no hardware ECC or GCM acceleration, unlike the P4, so only the peripherals it does have are
# enabled here.
# Allocate mbedTLS buffers from PSRAM rather than internal RAM.
#
# Internal RAM is the scarce resource here and TLS was the largest competitor for it. Worse than
# the size was the fragmentation: each handshake churns internal heap, and after a burst of them
# -- opening an aircraft popup starts photo and route fetches alongside the aircraft feed -- the
# largest free internal block fell from 29 KB to 14 KB and never recovered, so the aircraft
# fetch's own headroom check refused to run again and the radar stopped updating until reboot.
# Total free internal was never the problem; contiguity was.
#
# PSRAM has megabytes spare and no such pressure. Hardware AES/SHA still work: the crypto
# drivers check whether a buffer is DMA-capable and bounce it when it is not.
# CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

CONFIG_RADAR_WIFI_SSID=""
CONFIG_RADAR_WIFI_PASSWORD=""
CONFIG_RADAR_WIFI_MAX_RETRY=8
CONFIG_RADAR_CENTER_LAT="51.5073219"
CONFIG_RADAR_CENTER_LON="-0.1276474"
CONFIG_RADAR_FETCH_INTERVAL_SEC=10

CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
# The radar performs long LVGL redraws and HTTPS handshakes. Keep the task watchdog available
# for explicitly subscribed tasks, but do not monitor idle tasks because TLS bignum work and
# full-screen rendering can legitimately keep a core busy for longer than the idle watchdog
# threshold.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# LVGL draw buffers and RGB bounce buffers, in display lines, each 480*lines*2 bytes, two of each,
# all in internal RAM. Pinned here rather than left to the BSP's Kconfig defaults so they are
# visible next to the other internal-RAM decisions they compete with -- WiFi's buffers and the
# TLS handshake. 12 + 20 lines is 23 KB + 38 KB.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=12
CONFIG_BSP_LCD_RGB_BOUNCE_LINES=20
CONFIG_BSP_LCD_RGB_PCLK_MHZ=16

CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# 15 ms was the P4's refresh period. Software rendering on the S3 cannot sustain that over a
# 480x480 frame, and asking for it only queues work; 30 ms leaves the sweep smooth without the
# render task starving the fetch and TLS tasks.
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# Tempting on a software renderer, but LVGL's fast-mem attribute pulls its blend paths into
# DIRAM, and internal RAM is the scarce resource on this board: with it enabled only ~86 KB of
# the 341 KB remains for WiFi and the TLS handshake. LVGL runs from the flash cache instead.
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_IMGFONT=y
